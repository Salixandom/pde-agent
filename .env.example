# PDE-Agents-lite configuration
# Copy this file to .env and fill in your values.
# Exactly ONE provider key is needed to run with a real LLM.
# Leave all three blank to use the offline stub (no API calls).

# ── Provider keys (pick one) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# ── Model / generation settings ─────────────────────────────────────────────
# Override the default model for the chosen provider:
#   Anthropic: claude-sonnet-4-6 (default)  |  claude-opus-4-8
#   Google:    gemini-2.0-flash (default)   |  gemini-1.5-pro
#   OpenAI:    gpt-4o (default)
# PDE_AGENTS_MODEL=

# LLM temperature (0 = fully deterministic, recommended for agent tool use)
PDE_AGENTS_TEMPERATURE=0

# ── Storage ──────────────────────────────────────────────────────────────────
# Path to the SQLite run-history database.
# When running via Docker the volume mount sets this automatically.
PDE_AGENTS_DB=runs.db
